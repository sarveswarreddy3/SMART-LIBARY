# Environment Configuration for Smart Library Management System
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (SQLite by default, or Postgres for production e.g. postgresql://user:password@host:port/dbname)
DATABASE_URL=sqlite:///library.db

# Uploads
UPLOAD_FOLDER=static/uploads/covers
MAX_CONTENT_LENGTH=2097152

# Library Settings Defaults
DEFAULT_LOAN_DAYS=14
DEFAULT_FINE_PER_DAY=1.00
MAX_BOOKS_PER_MEMBER=4

# ── Library Assistant Chatbot (OpenAI) ───────────────────────────────────────
# Obtain your key from https://platform.openai.com/api-keys
# Billing must be enabled on your OpenAI account.
# Leave blank to run the chatbot in keyword-search fallback mode (no AI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
