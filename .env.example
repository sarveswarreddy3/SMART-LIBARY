# ==============================================================================
# Environment Configuration for Smart Library Management and Book Analytics System
# ==============================================================================

# Application Environment ('development' for local SQLite, 'production' for cloud deployment)
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for session signing and CSRF tokens
# In production, generate a secure random 32-byte key (e.g., using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev-secret-key-smart-library-academic-2026

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL=sqlite:///library.db

# Production Deployment (Hosted PostgreSQL e.g. Neon, Supabase, Render, Railway):
# DATABASE_URL=postgresql://username:password@ep-sample-host.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Initial Administrator Account Provisioning (Idempotent)
# ------------------------------------------------------------------------------
# Automatically created on initial startup if no admin exists.
# Existing passwords are never reset.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@library.edu
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_NAME=Apex Chief Librarian

# Set to 1 in production if you wish to display the demo credentials card on /login
SHOW_DEMO_CREDENTIALS=0

# ------------------------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------------------------
# On serverless (Vercel), this defaults automatically to /tmp/uploads/covers
UPLOAD_FOLDER=static/uploads/covers
MAX_CONTENT_LENGTH=2097152

# ------------------------------------------------------------------------------
# Library Settings Defaults
# ------------------------------------------------------------------------------
DEFAULT_LOAN_DAYS=14
DEFAULT_FINE_PER_DAY=1.00
MAX_BOOKS_PER_MEMBER=4

# ------------------------------------------------------------------------------
# AI-Powered Library Assistant Chatbot (OpenAI)
# ------------------------------------------------------------------------------
# Obtain your key from https://platform.openai.com/api-keys
# Leave blank to run the chatbot in keyword-search fallback mode (no AI API required).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
